{
  "name": "dodopayments-checkout",
  "version": "1.9.9",
  "description": "A TypeScript library for embedding Dodo Payments checkout (overlay and inline).",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "jsdelivr": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run clean && npm run build:types && npm run build:rollup",
    "build:rollup": "rollup -c",
    "build:types": "tsc --emitDeclarationOnly --declaration --declarationDir dist/types",
    "dev": "rollup -c -w",
    "lint": "eslint \"src/**/*.ts\"",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "pack": "npm pack",
    "release": "npm run build && npm pack",
    "release:next": "npm version prerelease --preid next --no-git-tag-version",
    "publish:next": "npm publish --tag next --access public",
    "publish:latest": "npm publish --access public"
  },
  "keywords": [
    "checkout",
    "payments",
    "iframe",
    "node",
    "inline",
    "dodopayments",
    "typescript"
  ],
  "author": {
    "name": "Dodo Payments",
    "email": "support@dodopayments.com",
    "url": "https://dodopayments.com"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/dodopayments/dodopayments-checkout/issues"
  },
  "homepage": "https://docs.dodopayments.com/api-reference/overlay-checkout",
  "devDependencies": {
    "@babel/core": "^7.23.5",
    "@babel/preset-env": "^7.23.5",
    "@rollup/plugin-babel": "^5.3.1",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^4.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^8.5.0",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0",
    "eslint": "^8.56.0",
    "rollup": "^2.79.1",
    "tslib": "^2.8.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
