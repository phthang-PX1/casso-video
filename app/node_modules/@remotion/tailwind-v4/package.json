{
	"repository": {
		"url": "https://github.com/remotion-dev/remotion/tree/main/packages/tailwind-v4"
	},
	"name": "@remotion/tailwind-v4",
	"version": "4.0.524",
	"description": "Enable TailwindCSS support in Remotion (TailwindCSS v4)",
	"main": "dist/cjs/index.js",
	"types": "dist/cjs/index.d.ts",
	"module": "dist/esm/index.mjs",
	"scripts": {
		"lint": "eslint src",
		"make": "tsgo -d && bun --env-file=../.env.bundle bundle.ts"
	},
	"author": "Jonny Burger <jonny@remotion.dev>",
	"contributors": [],
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/remotion-dev/remotion/issues"
	},
	"dependencies": {
		"css-loader": "7.1.4",
		"style-loader": "4.0.0",
		"tailwindcss": "4.2.0",
		"@tailwindcss/webpack": "4.2.0"
	},
	"peerDependencies": {
		"@remotion/bundler": "4.0.524"
	},
	"devDependencies": {
		"@remotion/bundler": "4.0.524",
		"@remotion/eslint-config-internal": "4.0.524",
		"eslint": "9.19.0",
		"@typescript/native-preview": "7.0.0-dev.20260217.1"
	},
	"keywords": [
		"remotion",
		"tailwind"
	],
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/cjs/index.d.ts",
			"module": "./dist/esm/index.mjs",
			"import": "./dist/esm/index.mjs",
			"require": "./dist/cjs/index.js"
		}
	},
	"homepage": "https://www.remotion.dev/docs/tailwind/tailwind"
}
